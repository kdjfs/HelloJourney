[Unit]
Description=HelloJourney XHS content service (signed API sidecar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xhs-sign
EnvironmentFile=/etc/hellojourney/env
Environment=XHS_SERVICE_PORT=8010
Environment=PYTHONIOENCODING=utf-8
ExecStart=/usr/bin/python3 /opt/xhs-sign/xhs_api.py
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
