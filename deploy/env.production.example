# ============================================================================
# 生产环境变量模板
#
#   1. cp deploy/env.production.example deploy/env.production
#   2. 把下面每个 xxx 换成真实值（env.production 已被 .gitignore 忽略，不会进仓库）
#   3. docker compose --env-file deploy/env.production up -d --build
#
# ⚠️ 三组变量分清用途：
#   - 无前缀            → 后端 Spring 读（运行时）
#   - VITE_*            → 前端**构建期**内联进产物，改完必须重建前端镜像
#   - PUBLIC_ORIGIN     → docker-compose 用它填后端 CORS 白名单
# ============================================================================

# ---------- 站点 ----------
# 后端 CORS 白名单；同源部署时其实用不到，但填上以后换域名不用改代码
PUBLIC_ORIGIN=https://journey.liufengwei.com
PORT=8000
SPRING_PROFILES_ACTIVE=prod

# ---------- 大模型（硅基流动 / 其他 OpenAI 兼容中转站）----------
LLM_ACTIVE_PROVIDER=siliconflow
LLM_SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 规划行程要求"一次输出整份 JSON 并通过校验"，别用小模型（4B/7B 会反复修复到超时）
LLM_SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# 单次调用超时；中转站慢模型单次可达 100s+
LLM_TIMEOUT=240
LLM_MAX_RETRIES=2
# 结构化行程（整份 JSON）单独的超时与修复次数
AGENT_STRUCTURED_TIMEOUT_SECONDS=240
AGENT_STRUCTURED_REPAIR_ATTEMPTS=3

# ---------- 高德（后端取景点图 / POI 搜索）----------
AMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAP_API_BASE_URL=https://restapi.amap.com

# ---------- 高德 Web JS（前端地图底图，构建期）----------
# 控制台里这把 Key 必须把站点域名加进「域名白名单」，否则地图是空白
VITE_AMAP_WEB_JS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AMAP_SECURITY_JS_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Google 地图底图（可选，构建期）----------
VITE_GOOGLE_MAPS_JS_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ---------- 运行时敏感配置 ----------
# 生产环境必须是 false：开了它，任何知道管理令牌的人都能改你的密钥
SETTINGS_ALLOW_SECRET_UPDATES=false
# 只在需要从网页里改配置时才设；留空则关闭该能力
SETTINGS_ADMIN_TOKEN=

# ---------- 可选：小红书实拍图 ----------
XHS_COOKIE=
XHS_XS=
XHS_XS_COMMON=
XHS_XT=

# ---------- 行程任务存储 ----------
TRIP_TASK_DATA_DIR=/app/data/trip_tasks
