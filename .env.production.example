# Copy to a secret manager or an untracked .env file. Never commit populated values.
LLM_ACTIVE_PROVIDER=deepseek
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional OpenAI-compatible route
LLM_SILICONFLOW_API_KEY=
LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

TENCENT_MAPS_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=

# Optional, fragile content adapter. Core planning continues when omitted.
XHS_COOKIE=
XHS_XS=
XHS_XS_COMMON=
XHS_XT=

CORS_ALLOWED_ORIGINS=https://travel.example.com
SETTINGS_ALLOW_SECRET_UPDATES=false
SETTINGS_ADMIN_TOKEN=
TRIP_TASK_TIMEOUT=300
TRIP_TASK_DATA_DIR=/app/data/trip_tasks
