{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hellojourney.local/schemas/trip-plan-v3.schema.json",
  "title": "HelloJourney TripPlan V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["city", "cities", "start_date", "end_date", "days", "weather_info", "overall_suggestions", "budget"],
  "properties": {
    "city": {"type": "string", "minLength": 1, "maxLength": 80},
    "cities": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "days": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/day"}},
    "weather_info": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/weather"}},
    "overall_suggestions": {"type": "string", "minLength": 1, "maxLength": 4000},
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "attraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "location", "visit_duration", "description", "category", "ticket_price"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "address": {"type": "string", "minLength": 1, "maxLength": 300},
        "location": {"$ref": "#/$defs/location"},
        "visit_duration": {"type": "integer", "minimum": 15, "maximum": 720},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "category": {"type": "string", "minLength": 1, "maxLength": 80},
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "photos": {"type": ["array", "null"], "maxItems": 12, "items": {"type": "string", "maxLength": 2000}},
        "poi_id": {"type": "string", "maxLength": 200},
        "image_url": {"type": ["string", "null"], "maxLength": 2000},
        "ticket_price": {"type": "integer", "minimum": 0, "maximum": 100000},
        "reservation_required": {"type": "boolean"},
        "reservation_tips": {"type": "string", "maxLength": 1000},
        "start_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "end_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "source": {"type": "string", "maxLength": 40},
        "provider": {"type": "string", "maxLength": 80},
        "verified_at": {"type": ["string", "null"], "maxLength": 40},
        "verification_status": {"type": "string", "enum": ["verified", "ai_suggested", "needs_verification"]}
      }
    },
    "hotel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "location", "price_range", "rating", "distance", "type", "estimated_cost"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "address": {"type": "string", "minLength": 1, "maxLength": 300},
        "location": {"$ref": "#/$defs/location"},
        "price_range": {"type": "string", "maxLength": 80},
        "rating": {"type": "string", "maxLength": 40},
        "distance": {"type": "string", "maxLength": 120},
        "type": {"type": "string", "maxLength": 80},
        "estimated_cost": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "poi_id": {"type": "string", "maxLength": 200},
        "source": {"type": "string", "maxLength": 40},
        "provider": {"type": "string", "maxLength": 80},
        "verified_at": {"type": ["string", "null"], "maxLength": 40},
        "verification_status": {"type": "string", "enum": ["verified", "ai_suggested", "needs_verification"]}
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description", "estimated_cost"],
      "properties": {
        "type": {"type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "address": {"type": ["string", "null"], "maxLength": 300},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "estimated_cost": {"type": "integer", "minimum": 0, "maximum": 100000},
        "source": {"type": "string", "maxLength": 40},
        "provider": {"type": "string", "maxLength": 80},
        "verified_at": {"type": ["string", "null"], "maxLength": 40},
        "verification_status": {"type": "string", "enum": ["verified", "ai_suggested", "needs_verification"]}
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "day_index", "city", "is_transfer_day", "transfer_info", "description", "transportation", "accommodation", "hotel", "attractions", "meals"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "day_index": {"type": "integer", "minimum": 0, "maximum": 29},
        "city": {"type": "string", "minLength": 1, "maxLength": 80},
        "is_transfer_day": {"type": "boolean"},
        "transfer_info": {"type": "string", "maxLength": 1000},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "transportation": {"type": "string", "minLength": 1, "maxLength": 120},
        "accommodation": {"type": "string", "minLength": 1, "maxLength": 120},
        "hotel": {"$ref": "#/$defs/hotel"},
        "attractions": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/attraction"}},
        "meals": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/meal"}}
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "city", "day_weather", "night_weather", "day_temp", "night_temp", "wind_direction", "wind_power"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "city": {"type": "string", "minLength": 1, "maxLength": 80},
        "day_weather": {"type": "string", "minLength": 1, "maxLength": 80},
        "night_weather": {"type": "string", "minLength": 1, "maxLength": 80},
        "day_temp": {"type": "number", "minimum": -80, "maximum": 70},
        "night_temp": {"type": "number", "minimum": -80, "maximum": 70},
        "wind_direction": {"type": "string", "maxLength": 80},
        "wind_power": {"type": "string", "maxLength": 80},
        "source": {"type": "string", "maxLength": 40},
        "provider": {"type": "string", "maxLength": 80},
        "verified_at": {"type": ["string", "null"], "maxLength": 40},
        "verification_status": {"type": "string", "enum": ["live_weather", "ai_suggested", "needs_verification"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_attractions", "total_hotels", "total_meals", "total_transportation", "total_inter_city_transport", "total"],
      "properties": {
        "total_attractions": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "total_hotels": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "total_meals": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "total_transportation": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "total_inter_city_transport": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "total": {"type": "integer", "minimum": 0, "maximum": 500000000}
      }
    }
  }
}
