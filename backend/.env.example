
# LLM配置 - 多供应商支持
# 当前活跃的LLM供应商 (openai / deepseek / glm / minimax / doubao / grok / kimi / dashscope / siliconflow)
LLM_ACTIVE_PROVIDER=openai

# 通用超时时间（秒）
LLM_TIMEOUT=60

# ---- OpenAI (GPT) ----
LLM_OPENAI_API_KEY=your-openai-api-key
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODEL=gpt-4

# ---- DeepSeek ----
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_MODEL=deepseek-chat

# ---- GLM (智谱) ----
LLM_GLM_API_KEY=
LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_GLM_MODEL=glm-4

# ---- MiniMax ----
LLM_MINIMAX_API_KEY=
LLM_MINIMAX_BASE_URL=https://api.minimax.chat/v1
LLM_MINIMAX_MODEL=MiniMax-Text-01

# ---- 豆包 (字节跳动) ----
LLM_DOUBAO_API_KEY=
LLM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_DOUBAO_MODEL=doubao-pro-4k

# ---- Grok (xAI) ----
LLM_GROK_API_KEY=
LLM_GROK_BASE_URL=https://api.x.ai/v1
LLM_GROK_MODEL=grok-2

# ---- Kimi (Moonshot) ----
LLM_KIMI_API_KEY=
LLM_KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_KIMI_MODEL=moonshot-v1-8k

# ---- 阿里百炼 ----
LLM_DASHSCOPE_API_KEY=
LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_MODEL=qwen-turbo

# ---- 硅基流动 ----
LLM_SILICONFLOW_API_KEY=
LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 小红书 Cookie
# 直接填浏览器请求头中的 Cookie 字符串，例如:
# XHS_COOKIE="a1=xxx; web_session=xxx; webId=xxx"
# 也兼容浏览器导出的 JSON Cookie 列表/对象串，程序会自动转换。
XHS_COOKIE="这里填写您网页端登录小红书复制来的 Cookie"

# 腾讯地图API配置
# 在腾讯位置服务控制台申请: https://lbs.qq.com/
# 需要开启: WebService API, 逆地址解析, 地点搜索, 路线规划, 天气服务
TENCENT_MAPS_KEY=your_tencent_maps_key_here

# Google Maps API 配置 (可选, 填写后优先使用 Google Maps，留空则使用腾讯地图)
# 需要在 Google Cloud Console 开启: Places API, Geocoding API, Routes API, Weather API
GOOGLE_MAPS_API_KEY=

# Google Maps 代理 (可选, 国内环境需要代理才能访问 Google API)
# 支持 HTTP/HTTPS 代理和 SOCKS5 代理，示例:
#   GOOGLE_MAPS_PROXY=http://127.0.0.1:7890
#   GOOGLE_MAPS_PROXY=socks5://127.0.0.1:1080
GOOGLE_MAPS_PROXY=
