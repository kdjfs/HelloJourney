# Copy to .env for local tooling, then export/source it before starting Spring.
# Spring Boot does not load .env files by itself. Never commit the populated file.

# Runtime
PORT=8000
LLM_ACTIVE_PROVIDER=deepseek
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=250

# Sensitive runtime writes are disabled by default. If temporarily enabled for
# local administration, use a long random token and never expose it to Web/UniApp.
SETTINGS_ALLOW_SECRET_UPDATES=false
SETTINGS_ADMIN_TOKEN=
TRIP_TASK_TIMEOUT=300
TRIP_TASK_DATA_DIR=data/trip_tasks

# DeepSeek
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI-compatible providers
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODEL=gpt-4

LLM_GLM_API_KEY=
LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_GLM_MODEL=glm-4

LLM_MINIMAX_API_KEY=
LLM_MINIMAX_BASE_URL=https://api.minimax.chat/v1
LLM_MINIMAX_MODEL=MiniMax-Text-01

LLM_DOUBAO_API_KEY=
LLM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_DOUBAO_MODEL=doubao-pro-4k

LLM_GROK_API_KEY=
LLM_GROK_BASE_URL=https://api.x.ai/v1
LLM_GROK_MODEL=grok-2

LLM_KIMI_API_KEY=
LLM_KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_KIMI_MODEL=moonshot-v1-8k

LLM_DASHSCOPE_API_KEY=
LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_MODEL=qwen-turbo

LLM_SILICONFLOW_API_KEY=
LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# Map and optional content providers
TENCENT_MAPS_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=
XHS_COOKIE=
XHS_XS=
XHS_XS_COMMON=
XHS_XT=
