# AMap requires the Web JS Key together with its paired security code: tile,
# custom-style, and service requests are rejected without a matching `jscode`, and
# the map then renders as an empty canvas with no error. The security code is read
# into window._AMapSecurityConfig from the app bundle (src/utils/env.ts), so it is
# inlined at build time: restart the dev server, or rebuild the container, after
# changing it. `docker-compose.dev.yml` forwards both values as build args.
VITE_USE_MOCK=true
VITE_API_BASE_URL=
VITE_AMAP_WEB_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# Google 地图底图。这一把是**浏览器** Key，用的是「HTTP 来源（referrer）限制」，
# 和后台的 GOOGLE_MAPS_API_KEY（服务端 Key，IP 限制）不是同一把，不要混用。
# 它同样在构建时内联进产物：改完要重启 dev server / 重新构建镜像。
# 为空时「设置 → 地图底图」里的 Google 选项仍然可选，但只会显示配置提示。
VITE_GOOGLE_MAPS_JS_KEY=
# 可选：Google Cloud 里创建的自定义 Map ID（云端配色）。留空回落到官方占位值
# DEMO_MAP_ID，功能与标记都正常，只是不能自定义底图配色。
VITE_GOOGLE_MAPS_MAP_ID=

# 「设置 → 模型中转站」面板的默认值（都可选）。
# VITE_RELAY_BASE_URL：OpenAI 兼容中转站的 API 地址，例如 https://api.siliconflow.cn/v1
# VITE_ADMIN_TOKEN：后端 settings.admin-token（即环境变量 SETTINGS_ADMIN_TOKEN）。
# ⚠️ 这两项会被内联进前端产物：只在本机 .env.local 里配，**不要把真实口令写进这里或提交到仓库**。
VITE_RELAY_BASE_URL=
VITE_ADMIN_TOKEN=
